{
  "name": "obsidian-kanbase",
  "version": "1.0.3",
  "description": "Kanban board view for Bases with drag and drop",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run --dir tests --reporter=default --reporter=junit --outputFile.junit=artifacts/vitest-junit.xml",
    "prepare:e2e": "node scripts/prepare-e2e.mjs",
    "test:e2e": "npm run build && npm run prepare:e2e && wdio run ./wdio.conf.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "tsc -noEmit -skipLibCheck && eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"e2e/**/*.js\" \"scripts/**/*.mjs\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"e2e/**/*.js\" \"scripts/**/*.mjs\" \"*.mjs\"",
    "validate:metadata": "node scripts/validate-metadata.mjs",
    "validate:bundle": "node scripts/validate-bundle.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "ci": "npm run lint && npm run format:check && npm test && npm run build && npm run validate:metadata && npm run validate:bundle"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "obsidian-md",
    "kanban",
    "board",
    "bases",
    "task-management"
  ],
  "author": "Lucio Paiva",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luciopaiva/obsidian-kanbase.git"
  },
  "bugs": {
    "url": "https://github.com/luciopaiva/obsidian-kanbase/issues"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.0.1",
    "@wdio/cli": "9.31.7",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.7",
    "@wdio/mocha-framework": "9.31.7",
    "@wdio/spec-reporter": "9.31.2",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-obsidianmd": "0.4.1",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.8.0",
    "mocha": "12.0.1",
    "obsidian": "1.13.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "wdio-obsidian-reporter": "3.2.0",
    "wdio-obsidian-service": "3.2.0"
  },
  "dependencies": {
    "fractional-indexing": "4.0.0"
  }
}
